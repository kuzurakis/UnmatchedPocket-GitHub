extends "res://tests/v38_cards_tests.gd"
func run():
 var g=fixture38("godzilla");var foe=g.hero_fighter(1);g.players[1].bot=false;combat(g,0,foe,c38(g,0,7),raw_card("defense",1));g=wait_choice(g,"v38_king");check(g.pending_choice.owner==1,"King choice belongs to opponent");var actions=g.actions_left;g=clone(g);g.choose_effect_option(1);check(g.actions_left==actions,"King action waits until after combat");g=stable(g);check(g.actions_left==actions+1,"King action granted after combat")
 g=fixture38("kraken");foe=g.hero_fighter(1);combat(g,0,foe,c38(g,0,10),raw_card("defense",20));g=wait_choice(g,"v38_place");check(g.pending_choice.fx.deep,"Deep placement carries repeat capability");g=clone(g);g.choose_effect_option(0);g=stable(g);check(g.phase=="action","Deep can finish without infinite loop")
 g=fixture38("moose");foe=g.hero_fighter(1);g.players[1].bot=false;combat(g,0,foe,c38(g,0,8),raw_card("defense",20));g=wait_choice(g,"v38_road");check(g.pending_choice.owner==1,"Roadblock movement chooser is opponent");var node=g.fighters[0].node;g=clone(g);g.choose_effect_option(0);g=stable(g);check(g.fighters[0].node!=node,"Roadblock moves the Moose exactly one step")
 g=fixture38("birds");foe=g.hero_fighter(1);g.players[0].hand=[c38(g,0,3),raw_card("attack",1)];g.players[1].hand=[raw_card("defense",20)];g.attack(0,foe,0);g.continue_attack();g=wait_choice(g,"v38_swarm_pay");var count=g.players[0].hand.size();g=clone(g);g.choose_effect_option(0);g=stable(g);check(g.players[0].hand.size()==count and g.players[0].discard.size()>=2,"Swarm pays one card and draws one during bonus combat")
 g=fixture38("godzilla");g.players[0].hand=[c38(g,0,10)];g.scheme(0,0);g=wait_choice(g,"v38_search");var at=g.pending_choice.indices[0];var target=g.players[0].deck[at].id;g=clone(g);g.choose_effect_option(0);g=stable(g);check(g.players[0].hand.any(func(c):return c.id==target),"Radiation search adds chosen card")
 g=fixture38("godzilla");g._v38.add_charge(0,0,1);g.players[0].discard=[raw_card("attack",3)];g._v38.add_charge(0,0,1);foe=g.hero_fighter(1);combat(g,0,foe,c38(g,0,2),raw_card("defense",20));g=stable(g);check(g._v38.charge(0).is_empty(),"Atomic Breath clears full charge after combat")
 print("V38_SEQUENCE checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
