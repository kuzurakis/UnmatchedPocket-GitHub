extends "res://tests/v35_ability_tests.gd"
func run():
 var g=fixture("abe_sapien");g.fighters[0].hp=10;var old=g.fighters[0].node;g.players[0].hand=[card(g,0,"hb_822")];g.scheme(0,0);g=stable(g);check(g.fighters[0].hp==11,"belt resolves healing choice");check(g.fighters[0].node!=old,"belt also resolves movement choice");check(g.players[0].hb_next_attack==1,"belt keeps next-attack bonus")
 var foe=adjacent(g,1);combat(g,1,foe,raw_card("attack",3),raw_card("defense",20));g=stable(g);check(g.last_combat.attack_value==4 and g.players[0].hb_next_attack==0,"next-attack bonus can apply to an Agent and is consumed")
 g=fixture("abe_sapien");g.fighters[1].alive=false;g.fighters[1].hp=0;direct(g,[{"kind":"v35_card","number":830,"stage":"after"}],card(g,0,"hb_830"));check(g.pending_choice.action=="v35_fighter","summon chosen before movement");g.choose_effect_option(0);check(g.pending_choice.action=="v35_return_space","summon asks actual space");g=clone(g);g.choose_effect_option(g.pending_choice.options.size()-1);check(g.fighters[1].alive and g.pending_choice.action=="v33_move","movement follows summon");check(g._int_array(g.pending_choice.ids).has(1),"newly summoned Agent can be selected to move");old=g.fighters[1].node;g.choose_effect_option(g._int_array(g.pending_choice.ids).find(1));g=stable(g);check(g.fighters[1].node!=old,"summoned Agent movement completes")
 print("V35_SEQUENCE checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
