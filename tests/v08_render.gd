extends "res://tests/v07_render.gd"
func run():
	folder = "res://../../work/verification-v0.8"
	root.size = Vector2i(1280,720)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder))
	app = load("res://main.tscn").instantiate()
	root.add_child(app)
	await settle()
	app.bot_timer.stop()
	app.I18n.set_language("ru")
	app.language_option.select(0)
	app.set_option.select(6)
	app._set_changed(6)
	await shot("menu")
	app._show_hero_info("little_red")
	await shot("new-set")
	app._close_popup()
	await start(["little_red","beowulf"],"heorot")
	app.engine.players[0].hand = []
	for id in ["what_s_that_in_my_basket","never_leave_the_path","what_big_eyes_you_have","stones_in_the_belly","into_the_woods"]: app.engine.players[0].hand.append(card("little_red",id))
	app.selected_card = -1
	app._refresh()
	await shot("game-ru")
	app._show_player_info(1)
	await shot("character")
	app._close_popup()
	await start(["houdini","genie"],"king_solomons_mine")
	app.selected_card = -1
	app._refresh()
	await shot("houdini")
	app.I18n.set_language("en")
	app._refresh()
	await shot("game-en")
	app._show_player_info(1)
	await shot("character-en")
	app._close_popup()
	app.I18n.set_language("ru")
	app._return_menu()
	await settle()
	app.set_option.select(7)
	app._set_changed(7)
	await shot("menu-houdini")
	print("V08_RENDER_OK")
	quit()
