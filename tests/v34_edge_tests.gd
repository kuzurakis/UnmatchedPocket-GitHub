extends "res://tests/v34_stars_tests.gd"
func fixture(hid: String,other="king_arthur"):
 var g=game([hid,other],true);g=stable(g);adjacent(g);return g
func run():
 var g=fixture("george_washington");var foe=g.hero_fighter(1);g.players[1].bot=false;g.players[0].hand=[card(g,0,"sns_787")];g.players[1].hand=[raw_card("defense",20),raw_card("defense",20)];g.attack(0,foe,0);g.continue_attack();check(g.pending_choice.action=="v34_ruse","attacker decides ruse before defense");g=clone(g);g.choose_effect_option(0);check(g.pending_choice.action=="v34_ruse_counter"and g.pending_choice.viewer==1,"defender decides random payment without seeing attack");g=clone(g);g.choose_effect_option(0);check(g.phase=="defend"and g.players[1].hand.size()==1 and g.players[0].ruses==3,"counter consumes random card and ready token");g.defend(0);g=stable(g);check(g.last_combat.attack_value<20,"removed ruse does not bypass defense")
 g=fixture("george_washington");foe=g.hero_fighter(1);g.players[0].ruses=3;g.players[1].hand=[raw_card("attack",1),raw_card("defense",2)];direct(g,[{"kind":"v34_look"}],{},0,1);check(g.pending_choice.get("kind","")=="hand_view"or g.pending_choice.get("cards",[]).size()==2,"look opens real hand panel before discard");g=stable(g)
 g=fixture("george_washington");foe=g.hero_fighter(1);g.fighters[1].node=int(g.nodes[int(g.fighters[foe].node)].neighbors[0]);g.players[0].ruses=3;g.players[1].hand=[raw_card("attack",1)];direct(g,[{"kind":"v34_look"}],{},0,1);g=stable(g);check(g.players[1].hand.is_empty()and g.players[0].ruses==4,"spy-adjacent reveal permits discard and regain")
 g=fixture("john_henry");g.fighters[g.hero_fighter(1)].node=0;g.fighters[0].node=12;var ids=g.nodes[12].neighbors.filter(func(n):return g._occupant(int(n))<0);var next=int(ids[0]);g.players[0].tracks=[next];g._start_ability(0,"Rail",[{"kind":"v34_rail","fid":0,"spaces":1}],"action");check(g.pending_choice.action=="v34_rail","rail gives explicit route decisions");g=clone(g);var index=g._int_array(g.pending_choice.ids).find(next);g.choose_effect_option(index);check(int(g.pending_choice.spaces)==1,"entering tracked cell costs zero movement");g.choose_effect_option(g._int_array(g.pending_choice.ids).find(-1));g=stable(g);check(g.fighters[0].node==next and g.players[0].used_paths.size()==1,"route commits tracked movement and path")
 g=fixture("wyatt_earp");foe=g.hero_fighter(1);g.actions_left=1;g._v34.grant_free(0,foe);g.players[0].hand=[raw_card("attack",2)];g.attack(0,foe,0);check(g.actions_left==1 and not g._v34.has_free(0),"free attack spent without normal action")
 g=fixture("rosie_the_riveter");g.players[0].upgrade_active=[0,1,2,3];g.actions_left=0;g.end_turn();check(g._v34.active_upgrades(0).is_empty()and not g.fighters[0].ranged,"four upgrades reset at end own turn")
 var model=Model.new();g=Model.new();g.setup(["king_arthur","medusa"],1,3434,"the_white_house");g.fighters[0].node=0;g.fighters[g.hero_fighter(1)].node=25;check(g._reachable(0,1).has(18),"normal fighter crosses secret passage for one step");check(not g.nodes[0].neighbors.has(18),"passages do not create combat adjacency")
 g=Model.new();g.setup(["svyatogor","medusa"],1,3434,"the_white_house");g.fighters[0].node=0;g._v19.body(0,0,-1);check(not g._v34.links(0,0).has(18),"large fighter excluded from secret passages")
 g=game(["rosie_the_riveter","king_arthur","medusa"],true);g=stable(g);var arthur=g.hero_fighter(1);var medusa=g.hero_fighter(2)
 var cell=0
 for fighter in g.fighters:
  if int(fighter.id)not in[0,arthur,medusa]:fighter.node=cell;cell+=1
 g.fighters[0].node=12;g.fighters[arthur].node=13;g.fighters[medusa].node=14;var hp1=int(g.fighters[arthur].hp);var hp2=int(g.fighters[medusa].hp)
 g._v33.wagon_finish({"owner":0,"v34_overrun":true},0,[13,14,19]);check(g.fighters[arthur].hp==hp1-1 and g.fighters[medusa].hp==hp2-1,"Overrun deals one to each passed opposing fighter")
 g=fixture("george_washington","houdini");g.players[1].bot=false;g.players[1].hand=[card(g,1,"a_magician_never_reveals_his_secrets"),raw_card("defense",1)];g.players[0].ruses=3
 direct(g,[{"kind":"v34_look"}],{},0,1);check(g.pending_choice.action=="v8_guard","Houdini can block new hand-view effect");g.choose_effect_option(0);g=stable(g);check(g.players[1].hand.size()==2 and g.players[0].ruses==3,"blocked view cannot continue to hand discard")
 print("V34_EDGE checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
