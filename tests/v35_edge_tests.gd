extends "res://tests/v35_ability_tests.gd"
func run():
 var g=fixture("abe_sapien");var foe=g.hero_fighter(1);var hp=g.fighters[0].hp;var node=g.fighters[0].node;g.players[0].ongoing=card(g,0,"hb_825")
 direct(g,[{"kind":"damage","amount":3,"target":"opposing_combatant"}],{},1,0);g=stable(g);check(g.fighters[0].hp==hp,"Counterhex blocks opposing effect damage")
 direct(g,[{"kind":"move","spaces":2,"fixed_fighter":0}],{},1,0);g=stable(g);check(g.fighters[0].node==node,"Counterhex blocks opposing movement")
 var size=g.players[0].hand.size();direct(g,[{"kind":"opponent_discard","amount":2}],{},1,0);g=stable(g);check(g.players[0].hand.size()==size,"Counterhex blocks forced discard")
 g._damage(0,2,false,true);check(g.fighters[0].hp==hp-2,"Counterhex does not protect against exhaustion");g.active=0;g._v35.start_turn();check(g.players[0].ongoing.is_empty(),"shield expires at next own turn start")
 g=fixture("abe_sapien");foe=g.hero_fighter(1);var shot=card(g,0,"hb_829");g.players[0].hand=[shot];g.players[1].hand=[raw_card("defense",2)];g.attack(0,foe,0);check(g.pending_choice.action=="v35_predict","Perfect Shot announces before defense");g=clone(g);g.choose_effect_option(3);check(g.pending_combat.face_up,"prediction makes attack face up");g=stable(g);check(g.last_combat.attack_value==int(shot.value)+2,"correct printed-value prediction adds two")
 g=fixture("liz_sherman");var fire=card(g,0,"hb_859");g.players[0].hand=[fire,raw_card("attack",1)];g._force_discard(0,2,true);check(g.players[0].hand.size()==1 and g.players[0].hand[0].burning,"two-card discard cannot recycle the same burning card twice")
 g=fixture("liz_sherman");g.players[0].hand=[fire,raw_card("attack",1)];direct(g,[{"kind":"opponent_discard","amount":2}],{},1,0);check(g.pending_choice.action=="v35_batch_discard","manual multiple discard uses distinct card selection");g=clone(g);g.choose_effect_option(0);check(g.pending_choice.cards.size()==1,"already chosen burning card excluded until batch resolves");g.choose_effect_option(0);g=stable(g);check(g.players[0].hand.size()==1 and g.players[0].hand[0].burning,"burning card returns after entire discard batch")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);g.players[0].ongoing=card(g,0,"hb_841");hp=g.fighters[foe].hp;g._damage(foe,1);check(g.fighters[foe].hp==hp-2,"Mortality adds exactly one to effect damage");g._damage(foe,2,false,true);check(g.fighters[foe].hp==hp-4,"exhaustion not increased by Mortality")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);g.fighters[0].node=12;g.fighters[1].node=13;g.fighters[foe].node=7;g.players[0].ongoing=card(g,0,"hb_843");hp=g.fighters[0].hp;combat(g,foe,0,raw_card("attack",7),card(g,0,"hb_833"));g=stable(g);check(g.fighters[0].hp==hp and not g.fighters[1].alive,"Bound in Blood transfers combat damage to Koschei");check(not g.players[0].ongoing.is_empty(),"redirected combat damage does not break Baba pact")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);g.players[0].ongoing=card(g,0,"hb_843");combat(g,foe,0,raw_card("attack",2),raw_card("defense",0));g=stable(g);check(g.players[0].ongoing.is_empty(),"two actual combat damage discards pact immediately")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);g.players[0].ongoing=card(g,0,"hb_840");g.players[0].hand=[raw_card("attack",1)];check(g.legal_targets(0,0).is_empty(),"Freedom forbids first-action attacks");g.players[0].actions_taken=1;check(g.legal_targets(0,0).has(foe),"Freedom permits attack after another action")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);g.players[0].ongoing=card(g,0,"hb_842");g.fighters[foe].hb_attack_turn=g.turn_number;hp=g.fighters[foe].hp;g.actions_left=0;g.end_turn();g=stable(g);check(g.fighters[foe].hp==hp-1,"Peace damages only hero marked as having attacked")
 g=fixture("baba_yaga");foe=g.hero_fighter(1);var turn=g.turn_number;combat(g,0,foe,card(g,0,"hb_839"),raw_card("defense",20));g=stable(g);check(g.turn_number>turn and g.active==1,"Out of Time ends current turn after combat")
 g=fixture("abe_sapien");foe=g.hero_fighter(1);g.fighters[foe].hp=1;combat(g,0,foe,raw_card("attack",2),raw_card("defense",0));g=stable(g);check(g.players[0].intuition==1,"defeating an adjacent fighter still activates intuition")
 g=fixture("liz_sherman");foe=g.hero_fighter(1);fire=card(g,0,"hb_859");hp=g.fighters[foe].hp;g.players[0].hand=[];g.players[0].deck=[fire,raw_card("attack",2)];g._v35.start_turn();g=stable(g);check(g.players[0].hand.size()==1 and g.players[0].hand[0].id==fire.id,"Wildfire reads bottom burning card and returns it to hand");check(g.fighters[foe].hp==hp-1,"burning start effect damages another fighter in Liz zone")
 g=fixture("liz_sherman");node=g.fighters[0].node;g.players[0].hand=[];g.players[0].deck=[raw_card("attack",2),fire];g._v35.start_turn();g=stable(g);check(g.fighters[0].node!=node and g.players[0].hand.is_empty(),"non-burning bottom card instead moves Liz without drawing it")
 print("V35_EDGE checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
